{
  "manifest_version": 3,
  "name": "Photopea No Ads Panel",
  "version": "1.0.0",
  "description": "Unofficial extension that removes Photopea's right-side ad panel and the 320px reserved space.",
  "permissions": [],
  "host_permissions": [
    "*://photopea.com/*",
    "*://*.photopea.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://photopea.com/*",
        "*://*.photopea.com/*"
      ],
      "js": ["inject.js"],
      "css": ["style.css"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
