{
  "manifest_version": 3,
  "name": "Photopea No Ads Panel",
  "version": "1.0.0",
  "description": "Unofficial extension that removes Photopea's right-side ad panel.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Photopea No Ads Panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [],
  "host_permissions": [
    "*://photopea.com/*",
    "*://*.photopea.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://photopea.com/*",
        "*://*.photopea.com/*"
      ],
      "js": ["inject.js"],
      "css": ["style.css"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
